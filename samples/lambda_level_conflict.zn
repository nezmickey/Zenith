/* lambda_level_conflict.zn
   文脈でレベルが分かる位置に書いた \[k] は「注釈」として扱う
   文脈と一致すれば冗長なだけでOK。矛盾すればエラー（\[k] が文脈を上書きすることはない） */

twice :: -> 1 -> 0 0;
twice<T> : -> -> T T -> T T = \ f : -> T T \ x : T f f x;


// OK: twice の第1引数はレベル1なので本体はレベル0。\[0] はそれと一致するので冗長なだけ
plus2 :: -> 0 0;
plus2 : -> int int = \ n : int twice<int> \[0] x : int + x 1 n;

// エラー: 文脈では本体はレベル0のはずだが、\[1] はレベル1と言っている
//   \[1] に従うと本体は + x まで読まれ、ラムダはレベル2の関数（-> int -> int int）になる
//   しかし twice の第1引数に求められているのはレベル1なので一致しない
//   → 「\[1] と書かれているが、この位置ではラムダの本体はレベル0でなければならない」
plus2_bad :: -> 0 0;
plus2_bad : -> int int = \ n : int twice<int> \[1] x : int + x 1 n;


// OK: トップレベル。外側のラムダの本体は -> int int（レベル1）なので \[1] と一致
add :: -> 0 -> 0 0;
add : -> int -> int int = \[1] a : int \ b : int + a b;

// エラー: 外側のラムダの本体はレベル1（内側のラムダを関数のまま返す）のはずだが、\[0] はレベル0と言っている
//   \[0] に従うと内側のラムダはその場で適用（ローカル変数扱い）になり、: の型 -> int -> int int と合わない
add_bad :: -> 0 -> 0 0;
add_bad : -> int -> int int = \[0] a : int \ b : int + a b;


// エラー: レベル0の位置（ローカル変数）。ラムダはその場で適用されるので本体はレベル0のはず
//   \[1] に従うと本体は + s まで読まれ、1 が余る（あるいは * n n が別の場所の引数として読まれる）
sq_plus_bad :: -> 0 0;
sq_plus_bad : -> int int = \ n : int \[1] s : int + s 1 * n n;