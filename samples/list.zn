/* 代数的データ構造を用いてリスト構造を作る。先に代数的データ構造とtype構文について要確認 */

type list<T> = | Nil | Cons T list<T>;
// listはConsで要素を無限につなげたものと解釈できる。こいつだけ小文字から初めてconsと書くか悩み中。同様にNilもnilと書くかも
// 呼び出すときは Nil<int> や Cons<int> 1 Cons<int> 2 Nil<int> などと書き、レベルは書かない
// ただ型推論が有効な場合は型を省略してもかまわない

// match文はtypeで宣言された型の値に対して各選択肢に応じた場合分けができる
// コンストラクタとは逆で "コンストラクタ名 引数1に対応する変数の名前 引数2に対応する変数の名前 .." などと書いて中身の値を分解できる
// パターンマッチの選択肢には<>の型名は書かない（matchで受け取る値からわかるから。逆にそれがわからない場合はエラー）
head[N] :: -> 0 N;
head[N]<T> : -> list<T> T = \ xs : list<T>
    match xs Nil error[N] "head: 空リスト" Cons x _ x;
sum :: -> 0 0;
sum : -> list<int> int = \ xs : list<int> match xs Nil 0 Cons x rest + x sum rest;

// リスト操作には head/tail/init/last/length などを最低限載せておく。ただし、このままだとtail関数やlength関数などはO(N)になってしまうが、そもそも関数型言語でそういう書き方をする方が稀だし、本当に必要ならそれを解決する組み込み配列はまた後で作ればいい。

// head/tailなどを空の配列に使ったときはエラーを返す必要がある。このような用途のために評価された時点で次の文字列を取り即時エラーを返す関数errorを用意する。
// errorはパースの整合性を取るために戻り値のレベルを示す。そして、次の文字列を引数として受け取り（これは評価が必要。もしこの中でさらにerrorが動いた場合そっちが返されてもとのerrorは返らない）出力後、プログラムを終了する。